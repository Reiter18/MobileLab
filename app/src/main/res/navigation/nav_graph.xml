<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.drivenext.app.presentation.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash" />

    <fragment
        android:id="@+id/noConnectionFragment"
        android:name="com.drivenext.app.presentation.noconnection.NoConnectionFragment"
        android:label="NoConnection"
        tools:layout="@layout/fragment_no_connection" />

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.drivenext.app.presentation.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding" />

    <!-- Заглушки: реализуются в следующих лабораторных работах -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.drivenext.app.presentation.placeholder.LoginPlaceholderFragment"
        android:label="Login"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.drivenext.app.presentation.placeholder.MainPlaceholderFragment"
        android:label="Main"
        tools:layout="@layout/fragment_placeholder" />

</navigation>
